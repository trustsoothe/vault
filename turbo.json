{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "globalEnv": [
    "CI_ENV"
  ],
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:chromium": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:firefox": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:autopolicy": {
      "cache": false,
      "dependsOn": [
        "^build:autopolicy"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "release:chromium": {
      "cache": false,
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "release:firefox": {
      "cache": false,
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "ci:test": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "typecheck": {
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
